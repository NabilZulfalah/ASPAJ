<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context=".BorrowingStatusActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:background="@drawable/toolbar_gradient"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Header dengan background wave -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:background="@drawable/top_wave" />

    <!-- Content Area (Card) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="-30dp"
        android:layout_weight="1"
        android:background="@drawable/card_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Judul di dalam Card -->
        <TextView
            android:id="@+id/textTitleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Riwayat Peminjaman"
            android:textColor="#1976D2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            />

        <!-- Status Filter -->
        <Spinner
            android:id="@+id/spinnerStatusFilter"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/spinner_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Daftar Riwayat Peminjaman -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewBorrowings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Belum ada riwayat peminjaman"
                android:textColor="#757575"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Riwayat peminjaman Anda akan muncul di sini"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

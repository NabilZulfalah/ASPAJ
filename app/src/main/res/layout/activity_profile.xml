<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".ProfileActivity">

    <!-- Left Panel: User Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#2196F3"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- User Avatar -->
        <androidx.cardview.widget.CardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imageViewProfilePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_asset_placeholder"
                android:contentDescription="User Avatar"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true" />

        </androidx.cardview.widget.CardView>

        <!-- User Name -->
        <TextView
            android:id="@+id/textViewName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Johan Maharoni"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Role Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@drawable/status_badge_background"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/textViewRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Class -->
        <TextView
            android:id="@+id/textViewClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="XI RPL 1"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Change Password Button -->
        <Button
            android:id="@+id/buttonChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_button_green"
            android:text="Ubah Password"
            android:textColor="@android:color/white" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button_red"
            android:text="Logout"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Right Panel: Account Settings -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Pengaturan Akun"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />


            <!-- Name Field -->
            <TextView
                android:id="@+id/textViewNameRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Nama: "
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <!-- Email Field -->
            <TextView
                android:id="@+id/textViewEmailRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Email: "
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <!-- Role Field -->
            <TextView
                android:id="@+id/textViewRoleRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Role: "
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <!-- Class Field -->
            <TextView
                android:id="@+id/textViewClassRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Kelas: "
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/buttonSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simpan Perubahan"
                    android:textColor="@android:color/white"
                    android:background="@drawable/rounded_button_green" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- No Column -->
        <TextView
            android:id="@+id/textview_no"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <!-- Name Column -->
        <TextView
            android:id="@+id/textview_nama_kelas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Class Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <!-- Level Column -->
        <TextView
            android:id="@+id/textview_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Level"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <!-- Program Study Column -->
        <TextView
            android:id="@+id/textview_program_studi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Program Study"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <!-- Description Column -->
        <TextView
            android:id="@+id/textview_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Class Description"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <!-- Aksi Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_edit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:backgroundTint="#4CAF50"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Edit Kelas"
                android:padding="4dp"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/button_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:backgroundTint="#F44336"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Delete Kelas"
                android:padding="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

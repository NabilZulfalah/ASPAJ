<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".BorrowConfirmActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewSelectedItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Barang yang Dipilih:"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editTextTujuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Alasan Peminjaman"
                android:padding="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editTextReturnDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tanggal Pengembalian"
                android:focusable="false"
                android:clickable="true"
                android:padding="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/buttonSubmitBorrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AJUKAN PEMINJAMAN"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/rounded_button"
                android:elevation="4dp"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".AssetListActivity">

    <!-- Latar Lengkung Atas -->
    <ImageView
        android:id="@+id/topWave"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="fitXY"
        android:src="@drawable/top_wave" />

    <!-- Logo Sekolah -->
    <ImageView
        android:id="@+id/logoSmk4"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/logo_smk4"
        android:contentDescription="Logo SMK 4"
        android:adjustViewBounds="true" />

    <!-- Card Konten -->
    <LinearLayout
        android:id="@+id/contentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logoSmk4"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="20dp"
        android:layout_marginHorizontal="24dp"
        android:elevation="8dp">

        <!-- Judul -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Aset"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Search dan Filter -->
        <LinearLayout
            android:id="@+id/filterLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editTextSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Cari nama / kode..."
                android:inputType="text"
                android:background="@drawable/edittext_background"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:padding="12dp"
                android:textColor="@android:color/black"
                 />

            <Spinner
                android:id="@+id/spinnerJurusan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/spinner_background" />
        </LinearLayout>

        <!-- Tombol Tambah Aset -->
        <Button
            android:id="@+id/buttonAddAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Tambah Aset"
            android:background="@drawable/rounded_button"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Daftar Aset -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAssets"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scrollbars="vertical" />

        <!-- Footer -->
        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/textViewSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jenis Barang 0\nTotal Unit 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/buttonSubmitBorrowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajukan Peminjaman"
                android:background="@drawable/rounded_button"
                android:textColor="@android:color/white"
                android:enabled="false"
                android:padding="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Latar Lengkung Bawah -->
    <ImageView
        android:id="@+id/bottomWave"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="fitXY"
        android:src="@drawable/bottom_wave" />

</RelativeLayout>

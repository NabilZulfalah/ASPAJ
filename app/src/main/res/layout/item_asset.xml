<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imageViewPhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Barang"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" />

        <TextView
            android:id="@+id/textViewKodeBarang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kode: " />

        <TextView
            android:id="@+id/textViewJumlahStok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stok: " />

        <TextView
            android:id="@+id/textViewLokasiBarang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokasi: " />

        <TextView
            android:id="@+id/textViewCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jurusan: " />

        <TextView
            android:id="@+id/textViewMerk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Merk: " />

        <TextView
            android:id="@+id/textViewSumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sumber: " />

        <TextView
            android:id="@+id/textViewTahun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tahun: " />

        <TextView
            android:id="@+id/textViewDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi: " />

        <TextView
            android:id="@+id/textViewValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Harga: " />

        <!-- Quantity Selector for Borrowing -->
        <LinearLayout
            android:id="@+id/quantitySelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="visible">

            <Button
                android:id="@+id/buttonDecrease"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:minWidth="48dp"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editTextQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="0"
                android:gravity="center"
                android:minWidth="60dp"
                android:maxLength="3" />

            <Button
                android:id="@+id/buttonIncrease"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/buttonEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit" />

            <Button
                android:id="@+id/buttonDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delete"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
